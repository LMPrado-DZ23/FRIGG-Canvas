{
  "name": "frigg-canvas",
  "version": "0.0.1",
  "private": true,
  "description": "FRIGG — canvas + orquestração de agentes (terminais de CLI de IA) + escritório 3D, sobre OmniRoute",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:renderer": "vite",
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w @lydell/node-pty",
    "dist:win": "npm run build && electron-builder --win nsis",
    "package:portable": "npm run build && node scripts/package-portable.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "app.frigg.canvas",
    "productName": "FRIGG",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
