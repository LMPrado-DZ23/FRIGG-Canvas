# FRIGG — configuração por ambiente (copie para .env; nunca commite segredos)

# URL do serviço OmniRoute (gerenciamento /api e inferência /v1). Ausente => indisponível.
# Endpoint local padrão do OmniRoute: http://localhost:20128 (inferência em /v1).
FRIGG_OMNIROUTE_URL=http://localhost:20128

# Dev: aponta o Electron para o dev server do Vite (npm run dev:renderer).
# FRIGG_DEV_URL=http://localhost:5173
